import re, sys
with open('$f') as fh:
    content = fh.read()
# Check table balance
opens = len(re.findall(r'<table', content))
closes = len(re.findall(r'</table>', content))
theads = len(re.findall(r'<thead', content))
tbodys = len(re.findall(r'<tbody', content))
if opens != closes:
    print(f'  TABLE MISMATCH: {opens} opens, {closes} closes')
elif theads != tbodys:
    print(f'  THEAD/TBODY MISMATCH: {theads} theads, {tbodys} tbodys')
else:
    print(f'  OK: {opens} tables, {theads} theads, {tbodys} tbodys')
# Check for broken relative links (href to .html without ../)
import os
dirpath = os.path.dirname('$f')
for m in re.finditer(r'href=\"([^\"]+\.html)\"', content):
    link = m.group(1)
    if link.startswith('http') or link.startswith('#'):
        continue
    if link.startswith('../'):
        target = os.path.normpath(os.path.join(dirpath, link))
    else:
        target = os.path.join(dirpath, link)
    if not os.path.exists(target):
        print(f'  BROKEN LINK: {link} -> {target}')
"; done
