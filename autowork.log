import html.parser
import sys
class Validator(html.parser.HTMLParser):
    def __init__(self):
        super().__init__()
        self.errors = []
        self.stack = []
        self.void_elements = {'br','hr','img','input','meta','link','area','base','col','embed','param','source','track','wbr'}
    def handle_starttag(self, tag, attrs):
        if tag not in self.void_elements:
            self.stack.append(tag)
    def handle_endtag(self, tag):
        if tag in self.void_elements:
            return
        if self.stack and self.stack[-1] == tag:
            self.stack.pop()
        elif tag in self.stack:
            while self.stack and self.stack[-1] != tag:
                self.errors.append(f'Unclosed <{self.stack.pop()}>')
            if self.stack:
                self.stack.pop()
v = Validator()
with open(sys.argv[1]) as f:
    v.feed(f.read())
if v.errors:
    for e in v.errors[:5]:
        print(f'  ERROR: {e}')
elif v.stack:
    print(f'  WARN: unclosed tags: {v.stack[-5:]}')
else:
    print('  OK')
