import re, sys
files = [
    'darnassian/vocabulary.html',
    'darnassian/grammar.html', 
    'darnassian/description.html',
    'thalassian/vocabulary.html',
]
for f in files:
    with open(f) as fh:
        content = fh.read()
    # Check basic structure
    if not content.startswith('<!DOCTYPE'):
        print(f'{f}: Missing DOCTYPE')
    if '</html>' not in content:
        print(f'{f}: Missing closing html tag')
    # Check table structure
    tables = re.findall(r'<table>', content)
    closes = re.findall(r'</table>', content)
    if len(tables) != len(closes):
        print(f'{f}: Table mismatch - {len(tables)} opens, {len(closes)} closes')
    theads = re.findall(r'<thead>', content)
    tbodys = re.findall(r'<tbody>', content)
    if len(theads) != len(tables):
        print(f'{f}: Missing thead in {len(tables)-len(theads)} tables')
    if len(tbodys) != len(tables):
        print(f'{f}: Missing tbody in {len(tables)-len(tbodys)} tables')
    print(f'{f}: OK ({len(tables)} tables)')
"
