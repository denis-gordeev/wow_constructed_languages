class Validator(html.parser.HTMLParser):
    def __init__(self):
        super().__init__()
        self.stack = []
        self.void_elements = {'br','hr','img','input','meta','link','area','base','col','embed','param','source','track','wbr'}
        self.last_pos = (1,0)
    def handle_starttag(self, tag, attrs):
        if tag not in self.void_elements:
            self.stack.append((tag, self.getpos()))
    def handle_endtag(self, tag):
        if tag in self.void_elements:
            return
        if self.stack and self.stack[-1][0] == tag:
            self.stack.pop()
        elif any(t[0] == tag for t in self.stack):
            while self.stack and self.stack[-1][0] != tag:
                print(f'Unclosed <{self.stack[-1][0]}> at line {self.stack[-1][1][0]}')
                self.stack.pop()
            if self.stack:
                self.stack.pop()
