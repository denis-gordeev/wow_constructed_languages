    issues.append('Missing closing </html>')
# Check balanced tags for key elements
for tag in ['head', 'body', 'table', 'thead', 'tbody', 'tr', 'ul', 'ol']:
    opens = content.count(f'<{tag}')
    closes = content.count(f'</{tag}>')
    if opens != closes:
        issues.append(f'Unbalanced <{tag}>: {opens} opens, {closes} closes')
# Check for broken links (href to .md files in visible text)
import re
md_links = re.findall(r'>([^<]*\.md[^<]*)<', content)
if md_links:
    issues.append(f'Visible .md link text: {md_links[:5]}')
if issues:
    for i in issues:
        print(f'  ISSUE: {i}')
else:
    print('  OK')
