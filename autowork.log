-<tr><td>d</td><td class="ipa">/d/</td><td></td></tr>
-<tr><td>f</td><td class="ipa">/f/</td><td></td></tr>
-<tr><td>h</td><td class="ipa">/h/</td><td></td></tr>
-<tr><td>k</td><td class="ipa">/k/</td><td></td></tr>
