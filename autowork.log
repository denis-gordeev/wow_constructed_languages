import html.parser
import sys

class HTMLChecker(html.parser.HTMLParser):
    def __init__(self):
        super().__init__()
        self.errors = []
        self.stack = []
        self.void_elements = {'br', 'hr', 'img', 'input', 'meta', 'link', 'area', 'base', 'col', 'embed', 'param', 'source', 'track', 'wbr'}
    
    def handle_starttag(self, tag, attrs):
        if tag not in self.void_elements:
            self.stack.append((tag, self.getpos()))
    
    def handle_endtag(self, tag):
        if tag in self.void_elements:
            return
        if self.stack and self.stack[-1][0] == tag:
            self.stack.pop()
        elif self.stack:
            self.errors.append(f'Mismatched tag: expected </{self.stack[-1][0]}> but found </{tag}> at line {self.getpos()[0]}')

files = [
    'zandali/grammar.html',
    'zandali/description.html',
    'thalassian/grammar.html',
    'thalassian/description.html',
    'nazja/description.html',
    'dwarven/description.html',
    'haranir/vocabulary.html',
]

all_ok = True
for f in files:
    try:
        with open(f, 'r') as fh:
            content = fh.read()
        checker = HTMLChecker()
        checker.feed(content)
        if checker.errors:
            print(f'ERRORS in {f}:')
            for e in checker.errors:
                print(f'  {e}')
            all_ok = False
        elif checker.stack:
            print(f'UNCLOSED TAGS in {f}: {[t[0] for t in checker.stack]}')
            all_ok = False
        else:
            print(f'OK: {f}')
    except Exception as e:
        print(f'FAILED: {f}: {e}')
        all_ok = False

if all_ok:
    print('\nAll files passed structural check.')
else:
    print('\nSome files have issues.')
"

