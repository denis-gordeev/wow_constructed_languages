import html.parser, sys
class Checker(html.parser.HTMLParser):
    def __init__(self):
        super().__init__()
        self.errors = []
        self.tag_stack = []
    def handle_starttag(self, tag, attrs):
        if tag not in ('br','hr','img','input','meta','link','col','area','base','embed','param','source','track','wbr'):
            self.tag_stack.append(tag)
    def handle_endtag(self, tag):
        if self.tag_stack and self.tag_stack[-1] == tag:
            self.tag_stack.pop()
        elif tag in self.tag_stack:
            while self.tag_stack and self.tag_stack[-1] != tag:
                self.errors.append(f'Unclosed tag: {self.tag_stack.pop()}')
            if self.tag_stack:
                self.tag_stack.pop()
c = Checker()
try:
    with open('$f') as fh: c.feed(fh.read())
    if c.errors: print('\n'.join(c.errors[:5]))
    elif c.tag_stack: print(f'Unclosed tags at end: {c.tag_stack[-3:]}')
    else: print('OK')
except Exception as e: print(f'Error: {e}')
"; done
