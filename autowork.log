from html.parser import HTMLParser
class Validator(HTMLParser):
    def __init__(self):
        super().__init__()
        self.errors = []
        self.stack = []
        self.void = {'br','hr','img','input','meta','link','area','base','col','embed','param','source','track','wbr'}
    def handle_starttag(self, tag, attrs):
        if tag not in self.void:
            self.stack.append(tag)
    def handle_endtag(self, tag):
        if tag in self.void:
            return
        if self.stack and self.stack[-1] == tag:
            self.stack.pop()
        else:
            self.errors.append(f'Mismatched tag: </{tag}>, expected </{self.stack[-1] if self.stack else \"nothing\"}>')

for f in ['earthen/vocabulary.html']:
    v = Validator()
    with open(f) as fh:
        v.feed(fh.read())
    if v.errors:
        for e in v.errors:
            print(f'{f}: {e}')
    else:
        print(f'{f}: OK (stack empty: {not v.stack})')
"

