import os, re
errors = []
for root, dirs, files in os.walk('.'):
    if root.startswith('./.git') or root.startswith('./.autowork'):
        continue
    for f in files:
        if f.endswith('.md'):
            path = os.path.join(root, f)
            with open(path) as fh:
                content = fh.read()
            # Check for markdown links to local files
            for m in re.finditer(r'\[([^\]]*)\]\(([^)]+)\)', content):
                link = m.group(2)
                if link.startswith('http') or link.startswith('#') or link.startswith('mailto'):
                    continue
                # Only check .md and .html links
                if link.endswith('.md') or link.endswith('.html'):
                    target = os.path.normpath(os.path.join(root, link))
                    if not os.path.exists(target):
                        errors.append(f'{path}: broken link to {link} (target: {target})')
if errors:
    for e in errors[:20]:
        print(e)
else:
    print('All local markdown links are valid')
