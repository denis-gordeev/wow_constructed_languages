# Check for unmatched tags
for tag in ['table', 'tr', 'td', 'th', 'div', 'nav', 'body', 'html']:
    opens = len(re.findall(f'<{tag}[ >]', html))
    closes = len(re.findall(f'</{tag}>', html))
