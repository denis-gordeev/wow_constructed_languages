from html.parser import HTMLParser
import sys
class Checker(HTMLParser):
    def __init__(self):
        super().__init__()
        self.errors = []
        self.stack = []
        self.void = {'br','hr','img','input','meta','link','area','base','col','embed','source','track','wbr'}
    def handle_starttag(self, tag, attrs):
        if tag not in self.void:
            self.stack.append((tag, self.getpos()))
    def handle_endtag(self, tag):
        if tag in self.void: return
        if self.stack and self.stack[-1][0] == tag:
            self.stack.pop()
        else:
            self.errors.append(f'Mismatched </{tag}> at line {self.getpos()[0]}')
    def handle_data(self, data): pass
c = Checker()
with open('$f') as fh:
    try:
        c.feed(fh.read())
        if c.errors:
            for e in c.errors[:5]: print(e)
        elif c.stack:
            for tag,pos in c.stack[:5]: print(f'Unclosed <{tag}> at line {pos[0]}')
        else:
            print('OK')
    except Exception as e:
        print(f'Parse error: {e}')
"; done
