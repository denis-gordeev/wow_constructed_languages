# Check for broken anchors
hrefs = re.findall(r'href=\"#(\w+)\"', html)
ids = set(re.findall(r'id=\"(\w+)\"', html))
for h in hrefs:
    if h not in ids:
        print(f'  BROKEN ANCHOR: #{h}')
if opens == closes and not any(h not in ids for h in hrefs):
    print('  OK')
"; done
