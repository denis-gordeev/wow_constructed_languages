+<tr><td><span class="inferred">*Hath'ar*</span></td><td><span class="inferred">*Hath-*</span> + <span class="inferred">*-ar*</span></td><td>Scourge faction (Zul'Drak)</td></tr>
+<tr><td><span class="inferred">*Nerub'ar*</span></td><td><span class="inferred">*Nerub-*</span> + <span class="inferred">*-ar*</span></td><td>Scourge faction (Borean Tundra)</td></tr>
+<tr><td><span class="inferred">*Ahn'kahar*</span></td><td><span class="inferred">*Ahn-*</span> + <span class="inferred">*-kahar*</span></td><td>Scourge faction (Ahn'kahet); <span class="inferred">*-kahar*</span> may be <span class="inferred">*-kah-*</span> + <span class="inferred">*-ar*</span></td></tr>
