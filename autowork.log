import os, re
errors = []
for root, dirs, files in os.walk('.'):
    if root.startswith('./.git') or root.startswith('./.autowork'):
        continue
    for f in files:
        if f.endswith('.html'):
            path = os.path.join(root, f)
            with open(path) as fh:
                content = fh.read()
            tables = re.findall(r'<table[^>]*>(.*?)</table>', content, re.DOTALL)
            for i, t in enumerate(tables):
                if '<thead>' not in t:
                    errors.append(f'{path}: table {i+1} missing <thead>')
                if '<tbody>' not in t:
                    errors.append(f'{path}: table {i+1} missing <tbody>')
            if '<table' in content and '</table>' not in content:
                errors.append(f'{path}: unclosed <table> tag')
if errors:
    for e in errors:
        print(e)
else:
    print('All HTML tables have proper thead/tbody structure')
