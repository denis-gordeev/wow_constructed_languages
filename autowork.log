import html.parser
import sys

errors = []

for path in [
    'shalassian/grammar.html',
    'shalassian/description.html',
    'nazja/grammar.html',
    'darnassian/grammar.html',
]:
    class Validator(html.parser.HTMLParser):
        def __init__(self):
            super().__init__()
            self.stack = []
            self.void = {'br','hr','img','input','meta','link','area','base','col','embed','param','source','track','wbr'}
        def handle_starttag(self, tag, attrs):
            if tag not in self.void:
                self.stack.append(tag)
        def handle_endtag(self, tag):
            if tag in self.void:
                return
            if self.stack and self.stack[-1] == tag:
                self.stack.pop()
            else:
                errors.append(f'{path}: unexpected closing </{tag}>, expected </{self.stack[-1] if self.stack else \"?\"}>')

    with open(path) as f:
        content = f.read()
    v = Validator()
    v.feed(content)
    if v.stack:
        errors.append(f'{path}: unclosed tags: {v.stack}')

if errors:
    for e in errors:
        print(e)
else:
    print('All HTML files valid')
"

