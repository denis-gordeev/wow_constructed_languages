import os, re

dirs = ['nerubian', 'ethereal', 'drust', 'haranir', 'earthen', 'vrykul', 'qiraji', 
        'tolvir', 'gnomish', 'shath-yar', 'draenei', 'dwarven', 'zandali', 'nazja',
        'darnassian', 'orcish', 'thalassian', 'eredun',
        'gutterspeak', 'shalassian', 'mogu', 'titan', 'taur-ahe']

issues = []
for d in dirs:
    path = f'{d}/vocabulary.html'
    if not os.path.exists(path):
        continue
    with open(path) as f:
        content = f.read()
    # Check basic structure
    if not content.strip().startswith('<!DOCTYPE') and not content.strip().startswith('<html'):
        issues.append(f'{path}: Missing DOCTYPE')
    if '</html>' not in content:
        issues.append(f'{path}: Missing closing </html>')
    # Check balanced tags
    for tag in ['head', 'body', 'table', 'thead', 'tbody', 'tr']:
        opens = content.count(f'<{tag}')
        closes = content.count(f'</{tag}>')
        if opens != closes:
            issues.append(f'{path}: Unbalanced <{tag}>: {opens} opens, {closes} closes')
    # Check for broken .md links in visible text
    md_links = re.findall(r'>([^<]*\.md[^<]*)<', content)
    if md_links:
        issues.append(f'{path}: Visible .md link text: {md_links[:3]}')

# Also check grammar.html and description.html for the 3 languages we modified
for d in ['darnassian', 'orcish', 'thalassian']:
    for ftype in ['grammar.html', 'description.html']:
        path = f'{d}/{ftype}'
        if not os.path.exists(path):
            continue
        with open(path) as f:
            content = f.read()
        for tag in ['head', 'body', 'table', 'thead', 'tbody', 'tr']:
            opens = content.count(f'<{tag}')
            closes = content.count(f'</{tag}>')
            if opens != closes:
                issues.append(f'{path}: Unbalanced <{tag}>: {opens} opens, {closes} closes')
        md_links = re.findall(r'>([^<]*\.md[^<]*)<', content)
        if md_links:
            issues.append(f'{path}: Visible .md link text: {md_links[:3]}')

if issues:
    for i in issues:
        print(f'  ISSUE: {i}')
else:
    print('All files pass HTML structural integrity checks')
