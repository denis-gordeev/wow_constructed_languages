import html.parser
import sys

class HTMLValidator(html.parser.HTMLParser):
    def __init__(self):
        super().__init__()
        self.stack = []
        self.errors = []
        self.void_elements = {'br', 'hr', 'img', 'input', 'meta', 'link', 'area', 'base', 'col', 'embed', 'param', 'source', 'track', 'wbr'}
    
    def handle_starttag(self, tag, attrs):
        if tag not in self.void_elements:
            self.stack.append((tag, self.getpos()))
    
    def handle_endtag(self, tag):
        if tag in self.void_elements:
            return
        if self.stack and self.stack[-1][0] == tag:
            self.stack.pop()
        elif self.stack:
            self.errors.append(f'Mismatched tag: </{tag}> at {self.getpos()}, expected </{self.stack[-1][0]}>')
        else:
            self.errors.append(f'Unexpected closing tag: </{tag}> at {self.getpos()}')

for f in ['nerglish/vocabulary.html', 'nerglish/grammar.html', 'nerglish/description.html', 'example-sentences.html', 'alien-comparative.html', 'shalassian/description.html', 'dwarven/description.html', 'shath-yar/description.html']:
    v = HTMLValidator()
    try:
        with open(f) as fh:
            v.feed(fh.read())
        if v.errors:
            print(f'{f}: ERRORS')
            for e in v.errors:
                print(f'  {e}')
        elif v.stack:
            print(f'{f}: UNCLOSED TAGS: {[t[0] for t in v.stack]}')
        else:
            print(f'{f}: OK')
    except Exception as e:
        print(f'{f}: EXCEPTION: {e}')
"

