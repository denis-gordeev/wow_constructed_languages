import os, re

# Fix visible .md link text in HTML files
# These are cases where the href correctly points to .html but the visible text says .md
# OR cases where .md references appear in visible text (not as href targets)

files_to_fix = {
    'nerubian/vocabulary.html': [],
    'haranir/vocabulary.html': [],
    'shath-yar/vocabulary.html': [],
    'zandali/vocabulary.html': [],
}

for path in files_to_fix:
    with open(path) as f:
        content = f.read()
    
    # Find all instances of visible .md text
    # Case 1: href to .html but visible text says .md
    # Fix: replace .md with .html in visible text when href has .html
    content = re.sub(
        r'href=\"([^\"]*?)\.html\"[^>]*>([^<]*?)\.md([^<]*?)<',
        lambda m: f'href=\"{m.group(1)}.html\">{m.group(2)}.html{m.group(3)}<' if m.group(1).replace('/', '/') + '.html' == m.group(1) + '.html' else m.group(0),
        content
    )
    
    # Case 2: href to .md (should be .html)  
    content = re.sub(r'href=\"([^\"]*?)\.md\"', lambda m: f'href=\"{m.group(1)}.html\"', content)
    
    with open(path, 'w') as f:
        f.write(content)

print('Fixed .md references in HTML files')
"
