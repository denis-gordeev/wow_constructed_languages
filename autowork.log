import re, os

files = [
    'shath-yar/grammar.html', 'shath-yar/description.html', 'shath-yar/vocabulary.html',
    'darnassian/grammar.html', 'darnassian/description.html',
    'zandali/grammar.html', 'zandali/description.html', 'zandali/vocabulary.html',
    'elven-comparative.html'
]

for f in files:
    with open(f) as fh:
        content = fh.read()
    # Find href links to local files
    links = re.findall(r'href=[\"\\']([^\"\\'#]*?)[\"\\']', content)
    local_links = [l for l in links if not l.startswith('http') and not l.startswith('#') and l]
    dir_of = os.path.dirname(f)
    for link in local_links:
        target = os.path.join(dir_of, link) if dir_of else link
        if not os.path.exists(target):
            print(f'BROKEN: {f} -> {link}')
print('Link check complete.')
"
