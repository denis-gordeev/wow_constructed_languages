+<tr><td>Light's Redoubt</td><td>&mdash;</td><td>Common compound</td></tr>
+<tr><td>Dunelle's Kindness</td><td>&mdash;</td><td>Arathi personal name (<em>Dunelle</em>) + Common possessive + Common noun</td></tr>
