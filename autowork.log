import re, sys
with open('$f') as fh: lines = fh.readlines()
issues = []
in_table = False
header_cols = 0
for i, line in enumerate(lines, 1):
    stripped = line.strip()
    if '|' in stripped:
        cols = len([c for c in stripped.split('|')]) - 2  # remove empty edges
        if not in_table:
            in_table = True
            header_cols = cols
        elif stripped.startswith('|--') or stripped.startswith('| ---') or re.match(r'^\|[\s\-:|]+\|$', stripped):
            continue  # separator
        elif header_cols > 0 and cols != header_cols:
            issues.append(f'Line {i}: {cols} cols vs {header_cols} header cols: {stripped[:60]}')
    else:
        in_table = False
        header_cols = 0
if issues: print('\n'.join(issues[:5]))
else: print('OK')
"; done
