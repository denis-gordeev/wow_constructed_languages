import re, sys
with open('$f') as fh:
    html = fh.read()
tables = html.count('<table')
theads = html.count('<thead')
tbodys = html.count('<tbody')
print(f'Tables: {tables}, Theads: {theads}, Tbody: {tbodys}')
# Check for .md link text visible in HTML
md_refs = re.findall(r'>[^<]*\.md[^<]*<', html)
if md_refs:
    for r in md_refs[:5]:
        print(f'VISIBLE .md REF: {r}')
else:
    print('No visible .md references')
# Check balanced tags
for tag in ['table', 'thead', 'tbody', 'tr']:
    opens = len(re.findall(f'<{tag}[ >]', html))
    closes = len(re.findall(f'</{tag}>', html))
    status = 'OK' if opens == closes else f'MISMATCH open={opens} close={closes}'
    print(f'<{tag}>: {status}')
" 2>&1; done
