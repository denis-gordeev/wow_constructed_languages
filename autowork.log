import html.parser
import sys

class HTMLValidator(html.parser.HTMLParser):
    def __init__(self):
        super().__init__()
        self.errors = []
        self.stack = []
        self.void_elements = {'area', 'base', 'br', 'col', 'embed', 'hr', 'img', 'input', 'link', 'meta', 'param', 'source', 'track', 'wbr'}
    
    def handle_starttag(self, tag, attrs):
        if tag not in self.void_elements:
            self.stack.append((tag, self.getpos()))
    
    def handle_endtag(self, tag):
        if tag in self.void_elements:
            return
        if self.stack and self.stack[-1][0] == tag:
            self.stack.pop()
        else:
            self.errors.append(f'Mismatched tag: </{tag}> at line {self.getpos()[0]}')

files = [
    'elven-comparative.html',
    'darnassian/grammar.html',
    'darnassian/vocabulary.html',
    'darnassian/description.html',
]

for f in files:
    try:
        v = HTMLValidator()
        with open(f) as fh:
            v.feed(fh.read())
        if v.errors:
            print(f'{f}: ERRORS')
            for e in v.errors[:5]:
                print(f'  {e}')
        elif v.stack:
            print(f'{f}: Unclosed tags: {[s[0] for s in v.stack[-3:]]}')
        else:
            print(f'{f}: OK')
    except Exception as e:
        print(f'{f}: Exception {e}')
"

