    # Count table rows (lines starting with |)
    table_rows = [l for l in content.split('\n') if l.strip().startswith('|')]
    # Check for consistent column counts within each table block
    in_table = False
    prev_cols = 0
    issues = []
    for row in table_rows:
        cols = len([c.strip() for c in row.split('|')]) - 2  # -2 for leading/trailing |
        if not in_table:
            in_table = True
            prev_cols = cols
        elif cols != prev_cols:
            if not row.strip().startswith('|---'):  # separator rows don't count
                issues.append(f'  Row with {cols} cols, expected {prev_cols}: {row.strip()[:80]}')
            prev_cols = cols
    if issues:
        print(f'{path}: Column mismatches:')
        for i in issues:
            print(i)
    else:
        print(f'{path}: OK')
