-<tr><td>Hungering</td><td>Descriptive; inhabits The Hungering Pool</td></tr>
-<tr><td>Fathomless</td><td>Descriptive; inhabits The Fangs</td></tr>
-<tr><td>Bleak</td><td>Descriptive; inhabits Bleak Sand islands</td></tr>
+<tr><th>Name</th><th>Pattern</th><th>Notes</th></tr>
+<tr><td>Brglmurgl</td><td>*Brgl-* + *-murgl*</td><td>Winterfin murloc</td></tr>
+<tr><td>Glrglrglr</td><td>*Glrgl-* + *-rglr*</td><td>Winterfin captive</td></tr>
+<tr><td>Mmmrrrggglll</td><td>*Mmmrrrggg-* + *-lll*</td><td>Grimscale chieftain</td></tr>
